---
const { frontmatter } = Astro.props;
const canonical = new URL("/aviso-de-privacidad", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title}</title>
    <meta name="description" content="Consulta cómo U Link Systems trata tus datos cuando usas su chat web." />
    <meta name="ulink-direct-notice-sha256" content={frontmatter.sourceSha256} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/direct-privacy.css" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <header class="notice-header">
      <div class="notice-frame notice-nav">
        <a class="notice-brand" href="/" aria-label="U Link Systems, inicio">U Link <strong>Systems</strong></a>
        <nav aria-label="Navegación principal">
          <a href="/">Inicio</a>
          <a href="/pricing">Planes de chatbots</a>
          <a href="/contact">Contacto</a>
        </nav>
      </div>
    </header>
    <main id="contenido" class="notice-main" tabindex="-1">
      <article>
        <slot />
      </article>
    </main>
    <footer class="notice-footer">
      <div class="notice-frame notice-nav">
        <p>U Link Systems</p>
        <nav aria-label="Enlaces de pie de página">
          <a href="/pricing">Planes de chatbots</a>
          <a href="/contact">Contacto</a>
          <a href="/aviso-de-privacidad" aria-current="page">Aviso de privacidad</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
