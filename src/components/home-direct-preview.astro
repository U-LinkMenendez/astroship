---
import { Icon } from "astro-icon/components";
---

<figure class="direct-preview">
  <figcaption class="preview-header">
    <span class="preview-icon"><Icon name="bx:chat" aria-hidden="true" /></span>
    <span class="preview-name">Vínculo Direct</span>
    <span class="example-label">Vista de ejemplo</span>
  </figcaption>

  <div class="preview-content">
    <div class="sample-chat">
      <p class="pane-title">Chat del sitio</p>
      <p class="message message-visitor">Quiero organizar las citas de mi negocio.</p>
      <p class="message message-advisor">Un asesor puede ayudarte a revisar cómo llevas tu agenda.</p>
    </div>

    <div class="sample-inbox">
      <p class="pane-title">Bandeja del asesor</p>
      <div class="sample-case">
        <Icon name="bx:message-rounded-dots" aria-hidden="true" />
        <div>
          <p>Consulta de agenda</p>
          <p class="case-status">Pendiente de atención</p>
        </div>
      </div>
      <p class="sample-devices">
        <Icon name="bx:devices" aria-hidden="true" />
        <span>Responde desde el celular o la computadora.</span>
      </p>
    </div>
  </div>
</figure>

<style>
  .direct-preview {
    min-width: 0;
    padding: .75rem;
    border: 1px solid #436182;
    border-radius: 1.25rem;
    background: #0f1e34;
    color: #eaf2ff;
    box-shadow: 0 1.5rem 3.5rem #030a18a1;
  }

  .preview-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .65rem;
    min-height: 3rem;
    padding: .2rem .3rem .65rem;
  }

  .preview-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: .65rem;
    background: #2853a3;
  }

  .preview-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .preview-name {
    font-size: .98rem;
    font-weight: 690;
  }

  .example-label {
    margin-inline-start: auto;
    color: #bfd0e9;
    font-size: .74rem;
  }

  .preview-content {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: .6rem;
  }

  .sample-chat,
  .sample-inbox {
    min-width: 0;
    padding: .95rem;
    border: 1px solid #2d4562;
    border-radius: .85rem;
    background: #14253e;
  }

  .pane-title {
    margin-bottom: .85rem;
    color: #d9e7f9;
    font-size: .82rem;
    font-weight: 650;
  }

  .message {
    max-width: 94%;
    padding: .68rem .78rem;
    border-radius: .72rem;
    font-size: .83rem;
    line-height: 1.48;
  }

  .message-visitor {
    margin-inline-start: auto;
    margin-bottom: .55rem;
    border-end-end-radius: .18rem;
    color: #f2f7ff;
    background: #244c85;
  }

  .message-advisor {
    border-end-start-radius: .18rem;
    color: #e9f3ff;
    background: #233957;
  }

  .sample-case,
  .sample-devices {
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    line-height: 1.46;
  }

  .sample-case {
    padding: .64rem;
    border: 1px solid #c8ddfa;
    border-radius: .55rem;
    background: #e6f0ff;
    color: #17325e;
    font-size: .77rem;
    font-weight: 680;
  }

  .sample-case svg,
  .sample-devices svg {
    flex: none;
    width: 1.17rem;
    height: 1.17rem;
  }

  .case-status {
    margin-top: .12rem;
    font-size: .72rem;
    font-weight: 500;
  }

  .sample-devices {
    margin-top: .85rem;
    color: #c2d2e7;
    font-size: .775rem;
  }

  @media (max-width: 1040px) and (min-width: 821px), (max-width: 480px) {
    .preview-content {
      grid-template-columns: 1fr;
    }
  }
</style>
