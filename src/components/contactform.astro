---
import { Icon } from "astro-icon/components";
import { contactWhatsapp } from "@/data/ulink-contact";
---

<form action={contactWhatsapp} method="get" target="_blank" rel="noopener noreferrer" id="consulta-whatsapp">
  <input type="hidden" name="text" value="Hola, quiero información de U Link Systems." />

  <label>
    Nombre
    <input type="text" autocomplete="name" maxlength="100" data-field-label="Nombre" />
  </label>

  <label>
    WhatsApp con lada
    <input type="tel" autocomplete="tel" maxlength="35" data-field-label="WhatsApp" />
  </label>

  <label>
    ¿En qué podemos ayudarte?
    <textarea rows="4" maxlength="1200" data-field-label="Consulta"></textarea>
  </label>

  <button type="submit" class="button button-primary">
    Abrir WhatsApp
    <Icon name="bx:right-arrow-alt" aria-hidden="true" />
  </button>
  <noscript><p>Puedes completar tu consulta al abrir WhatsApp.</p></noscript>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#consulta-whatsapp");
  const textInput = form?.elements.namedItem("text");
  if (form && textInput instanceof HTMLInputElement) {
    form.addEventListener("submit", () => {
      const lines = [textInput.defaultValue];
      const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-field-label]");
      for (const field of fields) {
        const value = field.value.trim();
        if (value) lines.push(field.dataset.fieldLabel + ": " + value);
      }
      textInput.value = lines.join("\n");
    });
  }
</script>

<style>
  form {
    display: grid;
    gap: .95rem;
    margin-top: 1.4rem;
  }

  label {
    display: grid;
    gap: .38rem;
    font-size: .93rem;
    font-weight: 650;
  }

  input:not([type="hidden"]),
  textarea {
    min-width: 0;
    width: 100%;
    padding: .72rem .8rem;
    border: 1px solid #9eb0c8;
    border-radius: .5rem;
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 450;
  }

  textarea {
    resize: vertical;
  }

  .button {
    justify-self: start;
  }

  noscript p {
    color: var(--muted);
    font-size: .9rem;
  }
</style>
