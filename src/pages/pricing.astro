---
import { Icon } from "astro-icon/components";
import { contactWhatsapp, directUrl, salesWhatsapp, whatsappDraft } from "@/data/ulink-contact";
import ULinkLayout from "@/layouts/ULinkLayout.astro";

const plans = [
  {
    name: "Semilla",
    description: "Para negocios que quieren orden",
    setup: "$1,500",
    monthly: "$799",
    includes: ["Pipeline de 3 etapas en CRM", "Chatbot básico", "Recordatorios automáticos", "WhatsApp o Instagram", "Reporte semanal"],
    action: "Empezar por WhatsApp",
    message: "Hola Ulises, me interesa el Plan Semilla",
  },
  {
    name: "Profesional",
    description: "Para negocios en crecimiento",
    setup: "$3,500",
    monthly: "$1,499",
    includes: ["Todo el Plan Semilla", "2 canales simultáneos", "Agenda automática", "Bot ampliado"],
    action: "Elegir Profesional",
    message: "Hola Ulises, me interesa el Plan Profesional",
    featured: true,
  },
  {
    name: "Total",
    description: "Para equipos y negocios consolidados",
    setup: "$6,500",
    monthly: "$2,499",
    includes: ["Todo el Plan Profesional", "3 canales activos", "Usuarios adicionales", "Reportes mensuales"],
    action: "Solicitar Total",
    message: "Hola Ulises, me interesa el Plan Total",
  },
  {
    name: "Empresa",
    description: "A la medida de tu operación",
    includes: ["Integraciones complejas", "Flujos a la medida", "Equipo dedicado", "Soporte prioritario"],
    action: "Hablar con Ulises",
    message: "Hola Ulises, me interesa el Plan Empresa, ¿podemos hablar?",
  },
];

const extras = [
  { name: "Reporte semanal automático", price: "+ $400 MXN al mes", description: "Resumen de prospectos, cierres y actividad del bot entregado cada lunes por WhatsApp o correo." },
  { name: "Secuencia posterior a la consulta", price: "+ $500 MXN al mes", description: "Entre 3 y 5 mensajes automáticos después de cada cita para pedir una reseña o fomentar la recompra." },
  { name: "Calificación de prospectos", price: "+ $300 MXN al mes", description: "El bot califica a cada prospecto y lo mueve a la etapa correspondiente en tu CRM." },
  { name: "Página de campaña", price: "$2,000 MXN de instalación", description: "Página para promociones, temporadas o lanzamientos, con botón a WhatsApp y alojamiento incluido." },
  { name: "Bienvenida automática", price: "+ $400 MXN al mes", description: "Envía documentos, instrucciones y datos de la primera cita a nuevos clientes por WhatsApp." },
  { name: "Recordatorios de pago", price: "+ $350 MXN al mes", description: "Avisos tres días antes, un día antes y el mismo día del vencimiento, con enlace de pago." },
];

const paymentTerms = [
  "Tarjeta de crédito, efectivo o transferencia bancaria",
  "Facturación disponible",
  "Contratación sin permanencia forzosa",
  "Puesta en marcha en 3 meses sin intereses",
];

const eventFeatures = [
  "Información del evento las 24 horas (horarios, sede, ponentes y código de vestimenta)",
  "Venta o reservación de boletos con enlace de pago",
  "Confirmación automática por WhatsApp con QR o código único",
  "Recordatorios un día antes y el día del evento",
  "Lista de espera automática cuando se agotan los lugares",
  "Base de contactos propia",
];
---

<ULinkLayout title="Planes de chatbots" description="Compara los planes de chatbot de U Link Systems, los cargos de instalación y los servicios adicionales.">
  <section class="page-intro" aria-labelledby="pricing-title">
    <div class="frame">
      <h1 id="pricing-title">Planes de chatbots</h1>
      <p>Elige cómo automatizar la atención de tu negocio. Los planes incluyen diseño del chatbot, conexión a tus canales activos y soporte con ajustes.</p>
      <a class="button chat-link" href={directUrl}>
        Chatear con un asesor
        <Icon name="bx:right-arrow-alt" aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="pricing-section frame" aria-labelledby="comparison-title">
    <h2 id="comparison-title">Compara los planes</h2>
    <div class="chat-plans">
      {plans.map((plan) => (
        <article class:list={["chat-plan", plan.featured && "chat-plan-featured"]}>
          <div class="plan-heading">
            <h3>Plan {plan.name}</h3>
            <p class="plan-description">{plan.description}</p>
          </div>
          <div class="plan-rate">
            {plan.setup ? (
              <>
                <p><strong>{plan.setup}</strong> MXN de instalación</p>
                <p>+ {plan.monthly} MXN al mes</p>
              </>
            ) : (
              <>
                <p class="custom-rate">Según diagnóstico</p>
                <p>Instalación y mensualidad personalizadas</p>
              </>
            )}
          </div>
          <ul class="included">
            {plan.includes.map((item) => (
              <li><Icon name="bx:check" aria-hidden="true" /><span>{item}</span></li>
            ))}
          </ul>
          <a
            class:list={["button", plan.featured ? "button-primary" : "button-outline"]}
            href={whatsappDraft(salesWhatsapp, plan.message)}
            aria-label={plan.action + " · Plan " + plan.name}>
            {plan.action}
          </a>
        </article>
      ))}
    </div>

    <aside class="payment" aria-labelledby="payment-title">
      <div>
        <h3 id="payment-title">Condiciones de pago</h3>
        <ul>{paymentTerms.map((item) => <li>{item}</li>)}</ul>
        <p>Precios más IVA. Se desglosa en factura.</p>
      </div>
      <a class="button button-outline" href={whatsappDraft(contactWhatsapp,"Hola, quiero agendar una demo de U Link Chatbots")}>
        Agendar una demo gratuita
        <Icon name="bx:right-arrow-alt" aria-hidden="true" />
      </a>
    </aside>
  </section>

  <section class="extras-section" aria-labelledby="extras-title">
    <div class="frame pricing-section">
      <h2 id="extras-title">Servicios adicionales</h2>
      <p class="section-copy">Agrega automatizaciones específicas al plan de tu negocio.</p>
      <div class="extras-grid">
        {extras.map(({ name, price, description }) => (
          <article class="extra">
            <h3>{name}</h3>
            <p>{description}</p>
            <strong>{price}</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="frame pricing-section">
    <div class="event" aria-labelledby="event-title">
      <div>
        <h2 id="event-title">Bot de Evento</h2>
        <p>Atiende a los asistentes y vende boletos de tu expo, feria o congreso por WhatsApp.</p>
        <ul class="included">
          {eventFeatures.map((feature) => (
            <li><Icon name="bx:check" aria-hidden="true" /><span>{feature}</span></li>
          ))}
        </ul>
      </div>
      <div class="event-price">
        <p>Desde <strong>$3,500 MXN</strong> por evento</p>
        <p>El precio final depende del alcance. La validación de códigos QR en el acceso se cotiza por separado.</p>
        <a class="button button-primary" href={whatsappDraft(salesWhatsapp,"Hola Ulises, tengo un evento y me interesa el Bot de Evento de U Link")}>
          Cotizar mi evento
          <Icon name="bx:right-arrow-alt" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</ULinkLayout>

<style>
  .chat-link {
    margin-top: 1.15rem;
    color: #0b254c;
    background: var(--blue-light);
  }

  .chat-link:hover {
    background: #c5e4ff;
  }

  .pricing-section {
    padding-block: clamp(2.15rem, 5vw, 4rem);
  }

  .pricing-section h2 {
    margin-bottom: 1.05rem;
    font-size: clamp(1.75rem, 3.35vw, 2.75rem);
    font-weight: 720;
    line-height: 1.1;
    letter-spacing: -.05em;
  }

  .chat-plans,
  .extras-grid {
    display: grid;
    gap: 1rem;
  }

  .chat-plans {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .chat-plan,
  .extra,
  .payment,
  .event {
    padding: clamp(1.1rem, 2.15vw, 1.65rem);
    border: 1px solid var(--line);
    border-radius: .85rem;
  }

  .chat-plan,
  .extra {
    display: flex;
    flex-direction: column;
    gap: .8rem;
    background: #fff;
  }

  .chat-plan-featured {
    border-color: #9ebbf1;
    background: var(--tint);
  }

  .pricing-section h3 {
    font-size: 1.17rem;
    font-weight: 710;
    letter-spacing: -.03em;
    line-height: 1.25;
  }

  .plan-description,
  .plan-rate,
  .included,
  .extra p,
  .payment,
  .section-copy,
  .event p {
    color: var(--muted);
    font-size: .92rem;
    line-height: 1.57;
  }

  .plan-description {
    margin-top: .33rem;
  }

  .plan-heading {
    min-height: 4.6rem;
  }

  .plan-rate {
    min-height: 4.2rem;
  }

  .plan-rate strong,
  .custom-rate {
    color: var(--accent-dark);
    font-size: 1.45rem;
    font-weight: 730;
  }

  .included {
    display: grid;
    gap: .53rem;
    margin-bottom: auto;
    padding-top: .8rem;
    border-top: 1px solid var(--line);
  }

  .included li {
    display: flex;
    align-items: flex-start;
    gap: .45rem;
  }

  .included svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent-dark);
  }

  .payment {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 1rem;
    background: var(--paper);
  }

  .payment h3 {
    color: var(--ink);
  }

  .payment ul {
    display: grid;
    gap: .35rem 1.6rem;
    margin: .8rem 0;
    padding-inline-start: 1.15rem;
    list-style: disc;
  }

  .extras-section {
    border-block: 1px solid var(--line);
    background: var(--paper);
  }

  .section-copy {
    margin: -.4rem 0 1.2rem;
  }

  .extras-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .extra strong {
    margin-top: auto;
    color: var(--accent-dark);
    font-size: .94rem;
  }

  .event {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .7fr);
    align-items: center;
    gap: 1.3rem 2.5rem;
    background: var(--tint);
  }

  .event .included {
    margin-top: .9rem;
  }

  .event-price {
    display: grid;
    gap: .75rem;
    align-items: start;
    padding: 1.15rem;
    border: 1px solid #c0d1eb;
    border-radius: .72rem;
    background: #fff;
  }

  .event-price strong {
    display: block;
    color: var(--accent-dark);
    font-size: 1.65rem;
    letter-spacing: -.04em;
  }

  @media (max-width: 1040px) {
    .chat-plans,
    .extras-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 740px) {
    .event {
      grid-template-columns: 1fr;
    }

    .payment {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 535px) {
    .chat-plans,
    .extras-grid {
      grid-template-columns: 1fr;
    }

    .plan-heading,
    .plan-rate {
      min-height: 0;
    }
  }
</style>
