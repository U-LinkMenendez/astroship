---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import operationPhoto from "@/assets/ulink-operacion.webp";
import HomeDirectPreview from "@/components/home-direct-preview.astro";
import { directLink } from "@/data/ulink-contact";
import ULinkLayout from "@/layouts/ULinkLayout.astro";

const description = "U Link Systems crea y mantiene el sitio web de tu negocio. Suma un sistema para organizar tu agenda, pedidos o cobranza con una mensualidad.";
const socialImage = await getImage({
  src: operationPhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "webp",
});

const solutions = [
  {
    icon: "bx:spreadsheet",
    title: "Controles de Excel",
    description: "Reúne los registros que tu equipo lleva en varias hojas y consulta la información en un solo lugar.",
  },
  {
    icon: "bx:calendar",
    title: "Agendas y citas",
    description: "Organiza horarios, reservas y cambios de cita para que tu equipo sepa qué espacios siguen disponibles.",
  },
  {
    icon: "bx:package",
    title: "Pedidos y ventas",
    description: "Sigue cada pedido desde la cotización hasta la entrega y consulta qué sigue pendiente.",
  },
  {
    icon: "bx:wallet",
    title: "Seguimiento de cobros",
    description: "Consulta vencimientos, abonos y saldos pendientes por cliente.",
  },
];

const plans = [
  {
    title: "Sitio Web",
    price: "$890",
    description: "Para que tus clientes encuentren tu negocio y puedan contactarte.",
    includes: [
      "Sitio de una página con tus servicios y un botón de contacto",
      "Alojamiento, HTTPS y mantenimiento técnico",
      "Un ajuste menor de contenido al mes",
    ],
    action: "Consultar Sitio Web",
    featured: false,
  },
  {
    title: "Sitio + Operación",
    price: "$1,690",
    description: "Para atraer clientes y organizar un proceso del día a día.",
    includes: [
      "Todo lo del plan Sitio Web",
      "Un módulo estándar, como agenda, control de pedidos o cobranza",
      "Alojamiento y mantenimiento del módulo",
    ],
    action: "Consultar Sitio + Operación",
    featured: true,
  },
];

const steps = [
  {
    icon: "bx:message-rounded-dots",
    title: "Cuéntanos qué necesitas",
    description: "Dinos qué vendes, cómo quieres recibir consultas y qué proceso necesitas ordenar.",
  },
  {
    icon: "bx:slider-alt",
    title: "Acordamos el alcance",
    description: "Revisamos contigo qué incluye el plan, qué necesitamos de tu equipo y qué requiere una cotización aparte.",
  },
  {
    icon: "bx:check",
    title: "Publicamos y lo mantenemos",
    description: "Pruebas el sitio con nosotros. Una vez publicado, nos encargamos del alojamiento y del mantenimiento acordado.",
  },
];
---

<ULinkLayout
  title="Tu sitio web y tus operaciones en un solo lugar"
  {description}
  socialImage={{ src: socialImage.src, alt: "Dos compañeros revisan la pantalla de una computadora" }}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="frame hero-layout">
      <div class="hero-copy">
        <p class="section-label">Sitios web y sistemas para pymes</p>
        <h1 id="hero-title">Organiza tu negocio <em>en un solo lugar.</em></h1>
        <p class="hero-description">
          Creamos sitios web y sistemas para organizar citas, pedidos o cobros.
          El alojamiento y el mantenimiento están incluidos en la mensualidad.
        </p>
        <div class="actions">
          <a class="button button-primary" {...directLink}>
            <Icon name="bx:message-rounded-dots" aria-hidden="true" />
            Chatear
          </a>
          <a class="button button-outline" href="#planes">
            Ver planes
            <Icon name="bx:right-arrow-alt" aria-hidden="true" />
          </a>
        </div>
      </div>

      <HomeDirectPreview />
    </div>
  </section>

  <section class="section plans-section" id="planes" aria-labelledby="plans-title">
    <div class="frame">
      <div class="section-intro">
        <h2 id="plans-title">Planes para empezar</h2>
        <p>La primera mensualidad incluye la puesta en marcha estándar. El alojamiento y el mantenimiento van incluidos cada mes.</p>
      </div>

      <div class="plan-grid">
        {plans.map((plan) => (
          <article class:list={["plan", plan.featured && "plan-featured"]}>
            <div>
              <h3>{plan.title}</h3>
              <p class="plan-price">
                <strong>{plan.price}</strong><span>MXN al mes</span>
              </p>
              <p class="plan-description">{plan.description}</p>
            </div>
            <ul class="plan-inclusions">
              {plan.includes.map((item) => (
                <li><Icon name="bx:check" aria-hidden="true" /><span>{item}</span></li>
              ))}
            </ul>
            <a class:list={["button", plan.featured ? "button-primary" : "button-outline"]} {...directLink}>
              {plan.action}
              <Icon name="bx:right-arrow-alt" aria-hidden="true" />
            </a>
          </article>
        ))}

        <article class="plan plan-custom">
          <div>
            <h3>Proyecto a la medida</h3>
            <p class="custom-price">Cotización personalizada</p>
            <p class="plan-description">Para adaptar el sistema a una operación con necesidades específicas.</p>
          </div>
          <ul class="plan-inclusions">
            <li><Icon name="bx:check" aria-hidden="true" /><span>Varios procesos o sucursales</span></li>
            <li><Icon name="bx:check" aria-hidden="true" /><span>Migración de datos o conexión con otras herramientas</span></li>
            <li><Icon name="bx:check" aria-hidden="true" /><span>Propuesta de implementación y mensualidad según el alcance</span></li>
          </ul>
          <a class="button button-outline" {...directLink}>
            Platicar mi proyecto
            <Icon name="bx:right-arrow-alt" aria-hidden="true" />
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section solutions-section" id="soluciones" aria-labelledby="solutions-title">
    <div class="frame">
      <div class="section-intro" id="para-quien">
        <h2 id="solutions-title">¿Qué necesitas organizar?</h2>
        <p>Si tu equipo trabaja entre hojas de cálculo, mensajes y agendas, puedes empezar por el proceso que más tiempo te ocupa.</p>
      </div>

      <ul class="solution-grid" id="casos">
        {solutions.map(({ icon, title, description }) => (
          <li class="solution">
            <span class="solution-icon"><Icon name={icon} aria-hidden="true" /></span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section process-section" id="como-trabajamos" aria-labelledby="process-title">
    <div class="frame">
      <div class="section-intro">
        <h2 id="process-title">Cómo trabajamos contigo</h2>
      </div>
      <div class="process-layout">
        <ol class="steps">
          {steps.map(({ icon, title, description }) => (
            <li>
              <span class="step-icon"><Icon name={icon} aria-hidden="true" /></span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))}
        </ol>
        <Image
          class="process-photo"
          src={operationPhoto}
          alt="Dos compañeros revisan la pantalla de una computadora, uno sentado y otro de pie"
          widths={[480, 720, 1080]}
          sizes="(max-width: 760px) calc(100vw - 36px), 42vw"
          format="webp"
          quality={84}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="contact-strip" id="contacto">
        <div>
          <h2>Cuéntanos cómo funciona tu negocio</h2>
          <p>Un asesor puede ayudarte a elegir un plan o revisar tu proyecto.</p>
        </div>
        <a class="button button-primary" {...directLink}>
          Hablar con un asesor
          <Icon name="bx:right-arrow-alt" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</ULinkLayout>

<style>
  .hero {
    color: var(--pale);
    background-color: var(--navy);
    background-image:
      radial-gradient(ellipse at 79% 42%, #2a51888a, transparent 65%),
      linear-gradient(#9fc3ff0c 1px, transparent 1px),
      linear-gradient(90deg, #9fc3ff0c 1px, transparent 1px);
    background-size: auto, 46px 46px, 46px 46px;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.2rem);
    min-height: 29rem;
    padding-block: clamp(3.2rem, 6vw, 5.75rem);
  }

  .section-label {
    color: var(--blue-light);
    font-size: .87rem;
    font-weight: 650;
  }

  .hero h1,
  .section-intro h2,
  .contact-strip h2,
  .solution h3,
  .plan h3,
  .steps h3 {
    font-weight: 700;
    letter-spacing: -.035em;
  }

  .hero h1 {
    margin-block: .85rem 1.2rem;
    font-size: clamp(2.9rem, 4.4vw, 4rem);
    line-height: 1.02;
    letter-spacing: -.06em;
  }

  .hero h1 em {
    display: block;
    color: var(--blue-light);
    font-style: normal;
  }

  .hero-description {
    max-width: 30rem;
    color: var(--on-dark);
    font-size: clamp(1rem, 1.4vw, 1.145rem);
    line-height: 1.66;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.6rem;
  }

  .hero .button-primary,
  .plan-featured .button-primary {
    color: #0b254c;
    background: var(--blue-light);
  }

  .hero .button-primary:hover,
  .plan-featured .button-primary:hover {
    background: #c5e4ff;
  }

  .hero .button-outline {
    border-color: #7994b4;
    color: var(--pale);
  }

  .hero .button-outline:hover {
    border-color: var(--blue-light);
    background: #1a3151;
  }

  :is(#contenido, .section, #para-quien, #casos, #contacto) {
    scroll-margin-top: var(--scroll-offset);
  }

  .section {
    padding-block: clamp(3rem, 5.7vw, 5.1rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .79fr);
    align-items: end;
    gap: .8rem 2.75rem;
    margin-bottom: 1.85rem;
  }

  .section-intro h2 {
    font-size: clamp(1.9rem, 3.4vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -.055em;
  }

  .section-intro > p {
    color: var(--muted);
    font-size: .98rem;
    line-height: 1.62;
  }

  .plans-section {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: clamp(1.2rem, 2.3vw, 1.85rem);
    border: 1px solid #c9d7e7;
    border-radius: .9rem;
    background: #fff;
    box-shadow: 0 .6rem 1.7rem #081b350a;
  }

  .plan-featured {
    border-color: #354f73;
    background: #122642;
    color: var(--pale);
  }

  .plan-custom {
    background: #eaf1fa;
  }

  .plan h3 {
    font-size: 1.37rem;
    line-height: 1.2;
  }

  .plan-price,
  .custom-price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .25rem .45rem;
    margin-block: .8rem .58rem;
  }

  .plan-price strong,
  .custom-price {
    color: var(--accent-dark);
    font-weight: 740;
    letter-spacing: -.045em;
  }

  .plan-price strong {
    font-size: 2.62rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .plan-price span {
    color: var(--muted);
    font-size: .8rem;
    font-weight: 620;
  }

  .custom-price {
    min-height: 2.62rem;
    align-items: center;
    font-size: 1.42rem;
    line-height: 1.16;
  }

  .plan-description {
    color: var(--muted);
    font-size: .93rem;
    line-height: 1.55;
  }

  .plan-featured .plan-price strong {
    color: var(--blue-light);
  }

  .plan-featured .plan-price span,
  .plan-featured .plan-description {
    color: var(--on-dark);
  }

  .plan-inclusions {
    display: grid;
    gap: .62rem;
    margin-bottom: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: .9rem;
    line-height: 1.5;
  }

  .plan-featured .plan-inclusions {
    border-color: #50698b;
  }

  .plan-inclusions li {
    display: flex;
    gap: .55rem;
  }

  .plan-inclusions svg {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--accent-dark);
  }

  .plan-featured .plan-inclusions svg {
    color: var(--blue-light);
  }

  .solution-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .solution {
    padding: 1.3rem;
    border: 1px solid var(--line);
    border-radius: .8rem;
  }

  .solution-icon,
  .step-icon {
    display: inline-grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: .6rem;
    color: var(--accent-dark);
    background: var(--tint);
  }

  .solution-icon svg,
  .step-icon svg {
    width: 1.47rem;
    height: 1.47rem;
  }

  .solution h3,
  .steps h3 {
    margin-bottom: .42rem;
    font-size: 1.2rem;
    line-height: 1.24;
    letter-spacing: -.03em;
  }

  .solution h3 {
    margin-top: .9rem;
  }

  .solution p,
  .steps p,
  .contact-strip p {
    color: var(--muted);
    font-size: .94rem;
    line-height: 1.62;
  }

  .process-section {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .process-layout {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.4rem, 4.5vw, 4rem);
  }

  .steps {
    display: grid;
    gap: 1rem;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: .8rem;
    padding-block: .75rem;
    border-bottom: 1px solid var(--line);
  }

  .steps li:first-child {
    border-top: 1px solid var(--line);
  }

  .process-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    max-height: 22rem;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: .9rem;
  }

  .contact-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(2.2rem, 5vw, 3.8rem);
    padding: clamp(1.3rem, 3vw, 2.3rem);
    border: 1px solid #c4d7f0;
    border-radius: .85rem;
    background: var(--tint);
  }

  .contact-strip h2 {
    margin-bottom: .4rem;
    font-size: clamp(1.47rem, 2.5vw, 2rem);
    line-height: 1.17;
  }

  .contact-strip .button {
    flex: none;
  }

  @media (max-width: 940px) {
    .solution-grid,
    .plan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .plan-custom {
      grid-column: 1 / -1;
    }

    .plan-custom .button {
      align-self: flex-start;
    }
  }

  @media (max-width: 820px) {
    .hero-layout,
    .process-layout {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .hero-layout {
      min-height: 0;
      padding-block: 2.35rem 2.5rem;
    }

    .hero h1 {
      max-width: 13ch;
      font-size: clamp(2.35rem, 9vw, 3.65rem);
    }

    .section-intro {
      grid-template-columns: 1fr;
    }

    .contact-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 570px) {
    .solution-grid,
    .plan-grid {
      grid-template-columns: 1fr;
    }

    .plan-custom .button {
      align-self: stretch;
    }
  }
</style>
